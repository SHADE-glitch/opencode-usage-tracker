{
  "schema_version": 1,
  "name": "cross-repo-usage-golden",
  "purpose": "One fixed input set, three independent trackers. The Usage Total expression and the date/window parsing were copied verbatim between codebuddy-usage-tracker (cbut), opencode-usage-tracker (ocut) and qoder-cn-usage-tracker (qcut) and then maintained separately; the NULL semantics have already drifted once (all-usage-trackers audit P1-12 / P2-17). This file pins what each repo's own code must compute for the same inputs, so a future drift fails a test instead of shipping. Expected values follow each repo's own documented definition (its README and the comments beside the expression), not the current implementation: where an implementation disagrees with its documentation, the test fails and the disagreement is reported, never smoothed over by editing either side.",
  "canonical_copy": "all-usage-trackers/scripts/tests/fixtures/cross_repo_golden.json",
  "copies": [
    "codebuddy-usage-tracker/scripts/tests/fixtures/cross_repo_golden.json",
    "opencode-usage-tracker/scripts/tests/fixtures/cross_repo_golden.json",
    "qoder-cn-usage-tracker/scripts/tests/fixtures/cross_repo_golden.json"
  ],
  "update_procedure": "Edit the canonical copy, then copy it byte-for-byte over the three per-repo copies and update the CANONICAL_SHA256 constant in each repo's test_cross_repo_golden.py. The digest pin is what makes a unilateral edit to one repo's copy fail that repo's own suite. The copies are per-repo (rather than one shared file read through a relative path) because each repository's CI checks out only itself; a sibling-relative read would be red on every runner.",
  "repos": {
    "cbut": {
      "module": "cbut_db",
      "table": "model_responses",
      "key_column": "message_id",
      "provider_column": "provider",
      "provider_display": "_PROVIDER_DISPLAY_EXPR: COALESCE(provider, 'builtin')",
      "columns": {
        "input_full": "prompt_tokens",
        "output": "completion_tokens",
        "cache_hit": "prompt_cache_hit_tokens",
        "cache_write": null,
        "usage_flag": "usage_available"
      },
      "input_full_mapping": "prompt_tokens IS the whole prompt (prompt = hit + miss + write), so input_full maps straight onto prompt_tokens and cache_hit onto prompt_cache_hit_tokens.",
      "usage_total_definition": "Usage Total = prompt + completion + COALESCE(cache hit, 0); NULL when either token part is missing (README: 'a display-only Input + Output + cache hit ... Fields absent from a response are shown as -, never as a fabricated 0').",
      "surfaces": {
        "per_row_sql": "cbut_db._USAGE_TOTAL_EXPR",
        "window_aggregate": "q_usage_summary(conn, start, end)['usage_total_tokens']",
        "model_rollup": "q_usage_model_stats(conn, start, end)"
      }
    },
    "ocut": {
      "module": "ocut_db",
      "table": "model_calls",
      "key_column": "call_id",
      "provider_column": "provider",
      "provider_display": "provider as stored",
      "columns": {
        "input_full_uncached": "prompt_tokens",
        "output": "completion_tokens",
        "cache_hit": "cache_read",
        "cache_write": "cache_write",
        "usage_flag": "usage_available"
      },
      "input_full_mapping": "OpenCode reports an UNCACHED prompt_tokens with cache_read/cache_write beside it, and its documented Input is all three added (README M13). So input_full maps as prompt_tokens = input_full - COALESCE(cache_hit,0) - COALESCE(cache_write,0), with cache_read = cache_hit and cache_write as given.",
      "usage_total_definition": "Usage Total = COALESCE(prompt,0) + completion + 2*COALESCE(cache_read,0) + COALESCE(cache_write,0) = (prompt + read + write) + completion + read; NULL only when completion is missing, or when every prompt part is missing. A partly reported row still contributes (ocut_db.py: 'Anything else contributes, so a partly-reported row is not dropped').",
      "surfaces": {
        "per_row_sql": "ocut_db._USAGE_TOTAL_EXPR",
        "per_row_python": "ocut-tui._usage_total_tokens(prompt, completion, cache_read, cache_write)",
        "window_aggregate": "sum of usage_total_tokens over q_usage_model_stats(conn, start, end) rows (ocut's q_usage_summary deliberately does not surface Usage Total)",
        "model_rollup": "q_usage_model_stats(conn, start, end)"
      }
    },
    "qcut": {
      "module": "qcut_db",
      "table": "model_calls",
      "key_column": "message_id",
      "provider_column": "provider",
      "provider_display": "provider as stored",
      "columns": {
        "input_full": "input_tokens",
        "output": "output_tokens",
        "cache_hit": "cache_read_tokens",
        "cache_write": null,
        "usage_flag": "has_usage"
      },
      "input_full_mapping": "input_tokens IS the whole prompt (cache_read_tokens is a subset of it), so input_full maps straight onto input_tokens and cache_hit onto cache_read_tokens.",
      "usage_total_definition": "Usage Total = input + output + COALESCE(cache read, 0); NULL when either token part is missing (README: 'Usage Total is input + output + cache hit by the family's definition').",
      "surfaces": {
        "per_row_sql": "qcut_db._USAGE_TOTAL_EXPR",
        "window_aggregate": "q_usage_summary(conn, start, end)['usage_total_tokens']",
        "model_rollup": "q_usage_model_stats(conn, start, end)"
      }
    }
  },
  "abstract_fields": {
    "input_full": "the whole prompt the model saw (cbut prompt_tokens; qcut input_tokens; ocut prompt+cache_read+cache_write)",
    "output": "the completion (cbut completion_tokens; ocut completion_tokens; qcut output_tokens)",
    "cache_hit": "the cached-read part that Usage Total re-adds (cbut prompt_cache_hit_tokens; ocut cache_read; qcut cache_read_tokens)",
    "cache_write": "the cache-write part, a column only ocut has; null elsewhere",
    "reports_usage": "whether the response reported usage at all: maps to cbut/ocut usage_available and qcut has_usage; false only for the all-NULL row"
  },
