  "date_parsing": {
    "note": "The typed date/time entry is copied verbatim across the three repos (cbut_db, qcut_db and ocut_db each carry their own parse_date/parse_time/parse_datetime). Dates are month-first in the ambiguous two-field form, a leading four-digit field is the year, a two-digit trailing year uses the %y 69/70 pivot, and an am/pm marker is accepted on input while everything displays 24-hour. Expectations are local-time ISO strings (or [hour, minute]), so they hold in every timezone; 'ValueError' means the call must raise.",
    "default_year": 2026,
    "parse_date": [
      {
        "input": "10-01",
        "expect": "2026-10-01"
      },
      {
        "input": "10/1",
        "expect": "2026-10-01"
