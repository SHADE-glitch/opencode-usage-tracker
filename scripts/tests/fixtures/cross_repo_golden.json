        "expect": "2026-10-01"
      },
      {
        "input": "3-9",
        "default_year": 1999,
        "expect": "1999-03-09"
      },
      {
        "input": "12-31-2026",
        "expect": "2026-12-31"
      },
      {
        "input": "10-01-69",
        "expect": "1969-10-01"
      },
      {
        "input": "10-01-70",
        "expect": "1970-10-01"
      },
      {
        "input": "not a date",
        "expect": "ValueError"
      },
      {
        "input": "13-45",
        "expect": "ValueError"
      },
      {
