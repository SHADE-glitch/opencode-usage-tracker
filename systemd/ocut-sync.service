[Unit]
Description=OpenCode usage tracker sync
Documentation=https://github.com/SHADE-glitch/opencode-usage-tracker

[Service]
Type=oneshot
# %h-relative on purpose: systemd's user PATH does not include ~/.local/bin, and
# an absolute path would hardcode one machine's home directory.
ExecStart=%h/.local/bin/ocut sync --quiet
Environment=LANG=C.UTF-8
Environment=PYTHONIOENCODING=utf-8
# The index walk is I/O bound and must never compete with a live OpenCode session.
Nice=10
